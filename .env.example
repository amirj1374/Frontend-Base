# Copy this file to the mode-specific file used by Vite (for example .env.dev).
# These values are public browser configuration. Never place client secrets here.
VITE_PORT=5050
VITE_API_BASE_URL=https://api.example.invalid
VITE_BASE_URL=/
VITE_APP_TITLE=Vosool Frontend
VITE_APP_ENV=development
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=https://identity.example.invalid
VITE_KEYCLOAK_REALM=example-realm
VITE_KEYCLOAK_CLIENT_ID=vosool-frontend
VITE_AUTH_FALLBACK_LOGIN_URL=/login
VITE_AUTH_FALLBACK_AUTHORIZATION_URL=/unauthorized
VITE_DEBUG=false
