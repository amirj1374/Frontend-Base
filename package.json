{
  "name": "jalili-project",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prelive": "vite --mode prelive",
    "dev:live": "vite --mode live",
    "dev:demo": "vite --mode demo --host",
    "build": "bun run typecheck && vite build --mode dev",
    "build:dev": "bun run typecheck && vite build --mode dev",
    "build:prelive": "bun run typecheck && vite build --mode prelive",
    "build:live": "bun run typecheck && vite build --mode live",
    "build:demo": "bun run typecheck && vite build --mode demo",
    "build:analyze": "bun run build && bunx vite-bundle-analyzer dist/stats.html",
    "preview": "vite preview --port 5050 --host",
    "preview:dev": "vite preview --port 5050 --host",
    "preview:prelive": "vite preview --port 5050 --host",
    "preview:live": "vite preview --port 5050 --host",
    "preview:demo": "vite preview --port 9090 --host",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:watch": "vue-tsc --noEmit --watch",
    "lint": "bun run lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,scss,css,json}\"",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate": "bun run lint:check && bun run typecheck && bun run test:coverage && bun run build",
    "clean": "rimraf dist node_modules/.vite"
  },
  "dependencies": {
    "@amirjalili1374/ui-kit": "1.10.34",
    "@dsb-norge/vue-keycloak-js": "^3.0.8",
    "@mdi/js": "^7.4.47",
    "@tabler/icons-vue": "^3.49.0",
    "apexcharts": "^8.0.0",
    "axios": "^1.20.0",
    "jalaali-js": "^2.0.1",
    "pinia": "^4.0.3",
    "vee-validate": "4.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.1.12",
    "vue-router": "5.4.0",
    "vue3-apexcharts": "^1.11.2",
    "vue3-lottie": "^3.3.1",
    "vue3-perfect-scrollbar": "2.0.0",
    "vue3-persian-datetime-picker": "^1.2.2",
    "vue3-print-nb": "0.1.4",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "20.1.10",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "^20.14.6",
    "prettier": "3.9.10",
    "rimraf": "^6.1.3",
    "sass": "1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
